# =============================================================================
# LinkedIn Hashtag Engine - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values
# Never commit .env.local to version control
# =============================================================================

# -----------------------------------------------------------------------------
# NextAuth.js Configuration (REQUIRED)
# -----------------------------------------------------------------------------
# Your application URL (use production URL in production)
NEXTAUTH_URL=http://localhost:3000

# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here

# -----------------------------------------------------------------------------
# LinkedIn OAuth (REQUIRED)
# -----------------------------------------------------------------------------
# Get credentials from: https://www.linkedin.com/developers/
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret

# -----------------------------------------------------------------------------
# Google Gemini API (REQUIRED)
# -----------------------------------------------------------------------------
# Get API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# -----------------------------------------------------------------------------
# Google Analytics 4 (OPTIONAL - Phase 3)
# -----------------------------------------------------------------------------
# Get Measurement ID from: https://analytics.google.com/
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# -----------------------------------------------------------------------------
# Sentry Error Monitoring (OPTIONAL - Phase 3)
# -----------------------------------------------------------------------------
# Get DSN from: https://sentry.io/
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development

SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_ORG=
SENTRY_PROJECT=

# -----------------------------------------------------------------------------
# Google AdSense (OPTIONAL - Phase 4)
# -----------------------------------------------------------------------------
# Get Client ID from: https://www.google.com/adsense/
# Format: ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
