# =============================================================================
# LinkedIn Hashtag Refresh Engine - Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# Command: cp .env.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# REQUIRED - AI Generation
# -----------------------------------------------------------------------------
# Google Gemini API Key for AI-powered hashtag generation
# Get your free API key: https://makersuite.google.com/app/apikey
# Without this, the core hashtag generation feature will not work
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------------------------------------
# OPTIONAL - Application Configuration
# -----------------------------------------------------------------------------
# Public URL of your application (used for metadata, SEO, and redirects)
# Development: http://localhost:3000
# Production: https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000  # Production: https://ai-linkedin-hashtag-refresh-engine-app.vercel.app

# Node environment (automatically set by hosting providers)
# Options: development, production, test
NODE_ENV=development

# -----------------------------------------------------------------------------
# OPTIONAL - LinkedIn OAuth Integration (Future Feature - Phase 2)
# -----------------------------------------------------------------------------
# Required only if you want to enable LinkedIn OAuth authentication
# Get these from: https://www.linkedin.com/developers/apps
# Leave empty if not using LinkedIn OAuth yet

# LinkedIn App Client ID
LINKEDIN_CLIENT_ID=

# LinkedIn App Client Secret (Keep this secret!)
LINKEDIN_CLIENT_SECRET=

# OAuth Callback URL (must match your LinkedIn app settings)
# Format: https://your-domain.com/api/auth/linkedin/callback
LINKEDIN_REDIRECT_URI=

# -----------------------------------------------------------------------------
# OPTIONAL - Database (Future Feature - Phase 3)
# -----------------------------------------------------------------------------
# Database connection string (PostgreSQL, MySQL, MongoDB, etc.)
# Required when you add post history and user data persistence
# DATABASE_URL=

# -----------------------------------------------------------------------------
# OPTIONAL - Payment Integration (Future Feature - Phase 2)
# -----------------------------------------------------------------------------
# Stripe API Keys for payment processing
# Get from: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# -----------------------------------------------------------------------------
# OPTIONAL - Analytics & Monitoring
# -----------------------------------------------------------------------------
# Google Analytics Measurement ID
# NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Sentry DSN for error tracking
# SENTRY_DSN=

# -----------------------------------------------------------------------------
# OPTIONAL - Email Service (Future Feature)
# -----------------------------------------------------------------------------
# Email service credentials for notifications
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=

# -----------------------------------------------------------------------------
# Development Tools
# -----------------------------------------------------------------------------
# Enable Next.js debug mode (only in development)
# DEBUG=false

# Enable verbose logging
# VERBOSE=false

# =============================================================================
# DEPLOYMENT INSTRUCTIONS
# =============================================================================
# 
# For Vercel Deployment:
# 1. Go to: https://vercel.com/your-project/settings/environment-variables
# 2. Add GEMINI_API_KEY (required)
# 3. Add NEXT_PUBLIC_APP_URL with your production URL
# 4. Select environments: Production, Preview, Development
# 
# For Local Development:
# 1. Copy this file: cp .env.example .env.local
# 2. Fill in your GEMINI_API_KEY
# 3. Run: npm run dev
# 
# =============================================================================
